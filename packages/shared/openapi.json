{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/profiles/me": {
      "get": {
        "operationId": "ProfilesController_getMe_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "404": {
            "description": "Profile not yet initialized"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the current user's profile + role-specific subprofile",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/v1/recruiter-profiles/me": {
      "get": {
        "operationId": "RecruiterProfilesController_getMe_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecruiterProfileEnvelopeDto"
                }
              }
            }
          },
          "403": {
            "description": "Not a recruiter"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the authenticated recruiter's full profile + company",
        "tags": [
          "recruiter-profiles"
        ]
      }
    },
    "/api/v1/recruiter-profiles/about": {
      "patch": {
        "operationId": "RecruiterProfilesController_updateAbout_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRecruiterAboutDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecruiterProfileEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Onboarding step 1: about you",
        "tags": [
          "recruiter-profiles"
        ]
      }
    },
    "/api/v1/recruiter-profiles/company": {
      "patch": {
        "operationId": "RecruiterProfilesController_updateCompany_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRecruiterCompanyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecruiterProfileEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Onboarding step 2: company details",
        "tags": [
          "recruiter-profiles"
        ]
      }
    },
    "/api/v1/recruiter-profiles/focus": {
      "patch": {
        "operationId": "RecruiterProfilesController_updateFocus_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRecruiterFocusDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecruiterProfileEnvelopeDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Onboarding step 3 (final): hiring focus — flips profile_completed=true",
        "tags": [
          "recruiter-profiles"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        },
        "summary": "Service health check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/register-candidate": {
      "post": {
        "description": "Frontend calls this AFTER supabase.auth.signUp() succeeds. The JWT identifies the new user; this endpoint creates profiles + candidate_profiles rows.",
        "operationId": "AuthController_registerCandidate_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitCandidateProfileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Profile already exists for this user"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Initialize a candidate profile after Supabase signUp",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register-recruiter": {
      "post": {
        "description": "Frontend calls this AFTER supabase.auth.signUp() succeeds. Creates profiles + recruiter_profiles + companies rows in a single transaction.",
        "operationId": "AuthController_registerRecruiter_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitRecruiterProfileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseEnvelopeDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          },
          "409": {
            "description": "Profile already exists for this user"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Initialize a recruiter profile + company after Supabase signUp",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "AuraHire API",
    "description": "Backend API for AuraHire — Explainable + Fair AI-Powered Recruitment",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CandidateSubprofileDto": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "object",
            "nullable": true
          },
          "summary": {
            "type": "object",
            "nullable": true
          },
          "locationCity": {
            "type": "object",
            "nullable": true
          },
          "locationCountry": {
            "type": "object",
            "nullable": true
          },
          "profileCompleted": {
            "type": "boolean"
          }
        },
        "required": [
          "headline",
          "summary",
          "locationCity",
          "locationCountry",
          "profileCompleted"
        ]
      },
      "RecruiterSubprofileDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string"
          },
          "jobTitle": {
            "type": "object",
            "nullable": true
          },
          "department": {
            "type": "object",
            "nullable": true
          },
          "profileCompleted": {
            "type": "boolean"
          }
        },
        "required": [
          "companyId",
          "jobTitle",
          "department",
          "profileCompleted"
        ]
      },
      "CompanySummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "industry": {
            "type": "object",
            "nullable": true
          },
          "size": {
            "type": "object",
            "nullable": true
          },
          "website": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "industry",
          "size",
          "website"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "candidate",
              "recruiter",
              "admin"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "deleted"
            ]
          },
          "phone": {
            "type": "object",
            "nullable": true
          },
          "avatarUrl": {
            "type": "object",
            "nullable": true
          },
          "profileCompleted": {
            "type": "boolean"
          },
          "candidateProfile": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/CandidateSubprofileDto"
              }
            ]
          },
          "recruiterProfile": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/RecruiterSubprofileDto"
              }
            ]
          },
          "company": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/CompanySummaryDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "status",
          "phone",
          "avatarUrl",
          "profileCompleted",
          "candidateProfile",
          "recruiterProfile",
          "company"
        ]
      },
      "ProfileResponseEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProfileResponseDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "RecruiterCompanyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "industry": {
            "type": "object",
            "nullable": true
          },
          "size": {
            "type": "object",
            "nullable": true
          },
          "website": {
            "type": "object",
            "nullable": true
          },
          "headquartersLocation": {
            "type": "object",
            "nullable": true
          },
          "description": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "industry",
          "size",
          "website",
          "headquartersLocation",
          "description"
        ]
      },
      "RecruiterProfileMeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "object",
            "nullable": true
          },
          "jobTitle": {
            "type": "object",
            "nullable": true
          },
          "department": {
            "type": "object",
            "nullable": true
          },
          "rolesHiringFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hiringVolumePerQuarter": {
            "type": "object",
            "nullable": true
          },
          "profileCompleted": {
            "type": "boolean"
          },
          "company": {
            "$ref": "#/components/schemas/RecruiterCompanyDto"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "phone",
          "jobTitle",
          "department",
          "rolesHiringFor",
          "hiringVolumePerQuarter",
          "profileCompleted",
          "company"
        ]
      },
      "RecruiterProfileEnvelopeDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RecruiterProfileMeDto"
          }
        },
        "required": [
          "data"
        ]
      },
      "UpdateRecruiterAboutDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20,
            "pattern": "^[\\d\\s+()-]+$"
          },
          "jobTitle": {
            "type": "string",
            "maxLength": 150,
            "nullable": true
          },
          "department": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          }
        },
        "required": [
          "fullName",
          "phone"
        ]
      },
      "UpdateRecruiterCompanyDto": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "industry": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "size": {
            "type": "string",
            "enum": [
              "1-10",
              "11-50",
              "51-200",
              "201-500",
              "501-1000",
              "1000+"
            ],
            "nullable": true
          },
          "website": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "headquartersLocation": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          }
        },
        "required": [
          "companyName"
        ]
      },
      "UpdateRecruiterFocusDto": {
        "type": "object",
        "properties": {
          "rolesHiringFor": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "hiringVolumePerQuarter": {
            "type": "string",
            "enum": [
              "1-5",
              "6-10",
              "11-25",
              "25+"
            ],
            "nullable": true
          }
        }
      },
      "InitCandidateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20,
            "pattern": "^[\\d\\s+()-]+$"
          }
        },
        "required": [
          "fullName",
          "phone"
        ]
      },
      "InitRecruiterProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 20,
            "pattern": "^[\\d\\s+()-]+$"
          },
          "companyName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "fullName",
          "phone",
          "companyName"
        ]
      }
    }
  }
}