{
  "name": "@aurahire/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./enums/*": "./src/enums/*.ts",
    "./constants/*": "./src/constants/*.ts",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "codegen": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@aurahire/db": "workspace:^",
    "@tanstack/react-query": "^5.100.7",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "orval": "^8.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
