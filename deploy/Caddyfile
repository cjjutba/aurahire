# AuraHire — Caddy reverse proxy
#
# Caddy auto-issues a Let's Encrypt cert for the sslip.io hostname on first
# request, then renews automatically. Port 80 must be reachable from the public
# internet (UFW already allows 80/443 — see provision.sh).
#
# Install path on droplet:  /etc/caddy/Caddyfile
# Validate config:          sudo caddy validate --config /etc/caddy/Caddyfile
# Reload (no downtime):     sudo systemctl reload caddy
# Logs:                     sudo journalctl -u caddy -f

167-71-217-44.sslip.io {
    encode gzip zstd

    # WebSocket path — long-lived connections, keep-alive heartbeats handled
    # by Socket.io (pingInterval 25s default). Disable read_timeout so an idle
    # WS isn't severed at the proxy layer; the upstream is in charge of the
    # connection lifecycle.
    @websockets path /socket.io/*
    reverse_proxy @websockets localhost:3333 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        transport http {
            read_timeout 0
        }
    }

    # Default REST/HTML traffic. Long timeout so resume parsing + AI scoring
    # don't get cut off, but bounded so a stuck upstream eventually surfaces.
    reverse_proxy localhost:3333 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        transport http {
            response_header_timeout 60s
            read_timeout 60s
        }
    }

    # Belt-and-braces security headers (Helmet on the API also sets some)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
