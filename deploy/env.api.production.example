# AuraHire API — production env template.
# Copy to apps/api/.env on the droplet and fill in real values.
# Never commit a filled version.

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
LOG_LEVEL=info

# Vercel frontend URL — must match exactly (no trailing slash, scheme included)
ALLOWED_ORIGINS=https://aurahire-thesis.vercel.app

# Public-facing URL used in transactional email links
APP_URL=https://aurahire-thesis.vercel.app

# ─── Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Redis (Docker on same host, localhost-only) ────────────────────
# REDIS_PASSWORD must match the value in deploy/.env
REDIS_URL=redis://default:<REDIS_PASSWORD>@127.0.0.1:6379

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ─── Email ──────────────────────────────────────────────────────────
# Option A (free, dev-style) — Mailpit on droplet. Emails are captured locally,
# never delivered to real inboxes. Fine for thesis demo if you don't need real send.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
RESEND_API_KEY=
FROM_EMAIL=onboarding@aurahire-thesis.vercel.app

# Option B (free 3k/mo, real delivery) — Resend.
# Sign up at resend.com, verify a domain, then:
# RESEND_API_KEY=re_...
# FROM_EMAIL=onboarding@<your-resend-verified-domain>

# ─── Debug ──────────────────────────────────────────────────────────
DRIZZLE_DEBUG=0
