# AuraHire API — production env template.
# Copy to apps/api/.env on the droplet and fill in real values.
# Never commit a filled version.

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
LOG_LEVEL=info
# Bind only on the docker bridge gateway IP. iams-nginx (in a container on
# the same deploy_default network, gateway 172.18.0.1) reverse-proxies
# 167-71-217-44.sslip.io → 172.18.0.1:3333. UFW denies the public internet
# from reaching :3333 directly, so this is the only way in.
HOST=172.18.0.1

# Frontend origins allowed by CORS — comma-separated, no trailing slashes, scheme included.
# Keep both the custom domain and the .vercel.app subdomain so previews keep working.
ALLOWED_ORIGINS=https://aurahire.site,https://aurahire-thesis.vercel.app

# Public-facing URL used in transactional email links and calendar invites.
APP_URL=https://aurahire.site

# ─── Supabase ───────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Redis (Docker on same host, localhost-only) ────────────────────
# REDIS_PASSWORD must match the value in deploy/.env
REDIS_URL=redis://default:<REDIS_PASSWORD>@127.0.0.1:6379

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ─── Email ──────────────────────────────────────────────────────────
# Production runs on Resend. Domain aurahire.site is verified on Resend (GoDaddy DNS).
# USE_RESEND=true forces the Resend SDK transport; RESEND_API_KEY must be set.
# (To temporarily fall back to Mailpit on the droplet, flip USE_RESEND=false and
#  point SMTP_HOST/SMTP_PORT at the local Mailpit container — emails will be caught
#  locally and never delivered to real inboxes.)
USE_RESEND=true
RESEND_API_KEY=re_...
FROM_EMAIL=hello@aurahire.site
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ─── Debug ──────────────────────────────────────────────────────────
DRIZZLE_DEBUG=0
