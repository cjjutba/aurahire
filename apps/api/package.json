{
  "name": "@aurahire/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require @swc-node/register --inspect=9229 --watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "generate:openapi": "node --require @swc-node/register scripts/generate-openapi.ts",
    "reset-db": "node --require @swc-node/register --env-file=.env scripts/reset-db.ts"
  },
  "dependencies": {
    "@aurahire/db": "workspace:*",
    "@aurahire/shared": "workspace:*",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^6.12.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^8.0.7",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@supabase/supabase-js": "^2",
    "cache-manager": "^7.2.8",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.29.1",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^5.3.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.32",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.2",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
