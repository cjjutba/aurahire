{
  "name": "@aurahire/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require @swc-node/register --inspect=9229 --watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:ai-parse": "tsx scripts/run-ai-parse-corpus.ts",
    "generate:openapi": "node --require @swc-node/register scripts/generate-openapi.ts",
    "reset-db": "node --require @swc-node/register --env-file=.env scripts/reset-db.ts",
    "seed-db": "node --require @swc-node/register --env-file=.env scripts/seed-db.ts"
  },
  "dependencies": {
    "@aurahire/db": "workspace:*",
    "@aurahire/shared": "workspace:*",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^6.12.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.15",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2",
    "bullmq": "^5.76.5",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.29.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "keyv": "^5.6.0",
    "mammoth": "^1.12.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "nestjs-zod": "^5.3.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.2",
    "jest": "^30.3.0",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(jose)/)"
    ]
  }
}
