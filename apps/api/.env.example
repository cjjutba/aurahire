# AuraHire backend env — copy to .env and fill in values for local development.
# Production values live in /home/deploy/aurahire/deploy/.env on the Digital Ocean Droplet (chmod 600, NOT committed).

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Bind address — defaults to 0.0.0.0 when unset. On the shared iams-backend
# droplet, production sets HOST=172.18.0.1 (docker bridge gateway) so the
# API is reachable from the iams-nginx container but not from the public
# internet. Leave unset locally.
# HOST=0.0.0.0
# Comma-separated origins allowed by Fastify CORS. Frontend dev runs at :3000.
# Production overrides this to include https://aurahire.site (see
# deploy/env.api.production.example).
ALLOWED_ORIGINS=http://localhost:3000
# Public-facing URL used in transactional email links (verify, reset, etc).
# Local dev points at the local frontend so the verification link is reachable
# via Mailpit. Production overrides this to https://aurahire.site (see
# deploy/env.api.production.example).
APP_URL=http://localhost:3000

# ─── Supabase (DB + Auth + Storage) ─────────────────────────────────
# Find these in Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key bypasses RLS — never commit, never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Drizzle connection string (Supabase pooler at port 5432, transaction mode).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Redis (cache + queue + throttle) ───────────────────────────────
# Local: docker-compose.dev.yml exposes Redis at localhost:6379 (no password).
# Production: deploy/docker-compose.prod.yml runs Redis on the DO Droplet bound to
# 127.0.0.1:6379 with REDIS_PASSWORD; set REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379.
# Used by: @nestjs/cache-manager, BullMQ, @nestjs/throttler.
REDIS_URL=redis://localhost:6379

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ─── Email (SMTP / Resend) ──────────────────────────────────────────
# Transport is driven by the USE_RESEND flag below — NOT by NODE_ENV.
#   USE_RESEND=false → Nodemailer SMTP → Mailpit catcher at localhost:1025 (dev default).
#   USE_RESEND=true  → Resend SDK (production; or dev opt-in to test real delivery).
# When flipping USE_RESEND=true locally, RESEND_API_KEY must be set and FROM_EMAIL
# must use a domain verified on Resend (otherwise sends are rejected).
USE_RESEND=false
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
FROM_EMAIL=hello@aurahire.site

# ─── Debug toggles ──────────────────────────────────────────────────
# Set to "1" to log every Drizzle SQL query (loud — enable only when investigating).
DRIZZLE_DEBUG=0
