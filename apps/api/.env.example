# AuraHire backend env — copy to .env and fill in values for local development.
# Production values live in Railway env config (NOT committed).

# ─── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Comma-separated origins allowed by Fastify CORS. Frontend dev runs at :3000.
ALLOWED_ORIGINS=http://localhost:3000
# Public-facing URL used in transactional email links (verify, reset, etc).
APP_URL=http://localhost:3000

# ─── Supabase (DB + Auth + Storage) ─────────────────────────────────
# Find these in Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key bypasses RLS — never commit, never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Drizzle connection string (Supabase pooler at port 5432, transaction mode).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Redis (cache + queue + throttle) ───────────────────────────────
# Local: docker-compose.dev.yml exposes Redis at localhost:6379.
# Production: Railway Redis addon auto-injects REDIS_URL.
# Used by: @nestjs/cache-manager, BullMQ, @nestjs/throttler.
REDIS_URL=redis://localhost:6379

# ─── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000

# ─── Email (SMTP / Resend) ──────────────────────────────────────────
# Dev: nodemailer → Mailpit catcher at localhost:1025.
# Production: Resend SDK via RESEND_API_KEY.
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
FROM_EMAIL=onboarding@aurahire.local

# ─── Debug toggles ──────────────────────────────────────────────────
# Set to "1" to log every Drizzle SQL query (loud — enable only when investigating).
DRIZZLE_DEBUG=0
